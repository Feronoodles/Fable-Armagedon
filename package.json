{
  "name": "card-game",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/game-engine.test.ts tests/packs.test.ts tests/combat-geometry.test.ts tests/registration-validation.test.ts tests/production-env.test.ts",
    "test:integration": "tsx --test tests/pack-transactions.test.ts",
    "test:docker": "node scripts/smoke-docker.mjs",
    "test:game": "tsx --test tests/game-engine.test.ts",
    "test:packs": "tsx --test tests/packs.test.ts",
    "seed": "tsx prisma/seed.ts",
    "build:seed": "esbuild prisma/seed.ts --bundle --platform=node --format=cjs --packages=external --outfile=prisma/seed.cjs",
    "sync:card": "tsx scripts/sync-card.ts",
    "sync:volcan-pack": "tsx scripts/sync-volcan-pack.ts",
    "sync:volcan-del-fin": "tsx scripts/sync-card.ts \"Volcán del fin\"",
    "sync:caracol-volcanico": "tsx scripts/sync-card.ts \"Caracol Volcánico\""
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "^5.22.0",
    "@types/js-cookie": "^3.0.6",
    "bcryptjs": "^3.0.3",
    "i18next": "^25.8.6",
    "i18next-http-backend": "4.0.4",
    "js-cookie": "3.0.8",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "next-i18next": "^15.4.3",
    "prisma": "^5.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^16.5.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
