POSTGRES_DB=fable_armageddon
POSTGRES_USER=fable_user
POSTGRES_PASSWORD=replace_with_64_random_hex_characters

# Compose builds DATABASE_URL and DIRECT_URL from the database values above.

NEXTAUTH_URL=https://example.com
NEXTAUTH_SECRET=replace_with_a_different_64_character_random_hex_secret

# Only exposed on the server's loopback interface, behind an HTTPS reverse proxy.
APP_PORT=3000
