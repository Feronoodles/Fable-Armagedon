# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keep real credentials private; commit only sanitized templates.
.env*
!.env.example
!.env.db.example
!.env.local.example
!.env.production.example

# Local databases, backups and private key material
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.dump
/backups/
*.key
*.p12
*.pfx
.npmrc
/.agents/
/.codex/
/.aws/
/.ssh/
*.log
*.sql.gz
/backup.sql

# Windows shell artifact
/nul

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/prisma/seed.cjs
/.artwork/
